{
  "expo": {
    "name": "grocify",
    "slug": "grocify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/grocify-icon.png",
    "scheme": "grocify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/grocify-icon.png",
      "bundleIdentifier": "com.anonymous.grocify"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06281E",
        "foregroundImage": "./assets/images/grocify-android-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.grocify"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@clerk/expo",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06281E",
          "image": "./assets/images/grocify-splash.png",
          "imageWidth": 170,
          "android": {
            "image": "./assets/images/grocify-splash.png",
            "imageWidth": 170
          },
          "dark": {
            "backgroundColor": "#041A14",
            "image": "./assets/images/grocify-splash.png",
            "imageWidth": 170
          }
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "grocify",
          "organization": "hussainislive"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9b9218c-a98f-4910-9cb7-5e8e79809e36"
      }
    },
    "owner": "hussainislive"
  }
}
